{
  "name": "setu-platform",
  "version": "1.0.0",
  "description": "SETU - Bridging Skills, Opportunities & Employment",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --prefix backend\" \"npm run dev --prefix client\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:server": "npm run dev --prefix backend",
    "dev:client": "npm run dev --prefix client",
    "seed": "npm run seed:catalogs --prefix backend",
    "seed:catalogs": "npm run seed:catalogs --prefix backend",
    "seed:dev-opportunities": "npm run seed:dev-opportunities --prefix backend",
    "verify": "npm run verify --prefix backend",
    "build:backend": "npm run build --prefix backend",
    "build:server": "npm run build --prefix backend",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:backend && npm run build:client",
    "start": "node backend/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
