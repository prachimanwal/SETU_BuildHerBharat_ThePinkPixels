# ==========================================
# SETU Backend Environment Configuration
# Builder Bharat 2026 – Build Her Bharat
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/setu_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/setu_db

# JWT Signing Secret (Generate a strong 32+ character random secret in production)
JWT_SECRET=replace_with_secure_random_32_char_secret

# Allowed Frontend Client URL (Netlify URL in production, http://localhost:5173 in local dev)
# Supports comma-separated values if allowing multiple origins
CLIENT_URL=https://oursetu.netlify.app

# Google OAuth 2.0 Web Client ID (Google Identity Services)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Must match VITE_GOOGLE_CLIENT_ID configured on Netlify
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
