# ==========================================
# SETU Backend Environment Configuration
# Builder Bharat 2026 – Build Her Bharat
# K.R. Mangalam University, Gurugram
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local fallback)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/setu_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/setu_db

# JWT & Session Secret Key (Generate a random 32+ character key in production)
SESSION_SECRET=setu_super_secret_jwt_key_2026_builder_bharat
JWT_SECRET=setu_super_secret_jwt_key_2026_builder_bharat

# Allowed Frontend Client URL (e.g. Netlify URL or local Vite)
CLIENT_URL=https://oursetu.netlify.app

# Google OAuth 2.0 Credentials (Google Cloud Console Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://setu-backend-api.onrender.com/api/auth/google/callback
