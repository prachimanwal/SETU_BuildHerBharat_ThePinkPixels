{
  "name": "setu-backend",
  "version": "1.0.0",
  "description": "SETU Standalone Backend API (Node.js, Express, TypeScript, MongoDB Atlas, Zod, JWT)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed/seed.ts",
    "verify": "tsx scripts/verify-all.ts",
    "test:auth": "tsx scripts/test-auth.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.11.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
