# Server Port
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/setu_db

# Secure JWT Session Secret
JWT_SECRET=replace_with_secure_random_32_char_secret

# Frontend Application Client URL
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
