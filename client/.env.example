# ==========================================
# SETU Frontend Environment Configuration
# ==========================================

# Backend API Base URL
# In local development: Leave blank to use Vite's /api proxy (http://localhost:5000)
# On Netlify: Set this to your live Render backend URL
VITE_API_URL=https://setu-backend-api.onrender.com

# Google OAuth 2.0 Web Client ID (Google Identity Services)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Must match GOOGLE_CLIENT_ID configured on the Render backend
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
