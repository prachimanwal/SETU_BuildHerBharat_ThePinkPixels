# ==========================================
# SETU Frontend Environment Configuration
# ==========================================

# Backend API Base URL
# In local development: Leave blank to use Vite's built-in /api proxy (http://localhost:5000)
# On Netlify: Set this to your live Render backend URL, e.g.:
VITE_API_URL=https://setu-backend-api.onrender.com

# Optional: Google OAuth 2.0 Client ID for frontend button
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
